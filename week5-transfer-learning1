{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"41ce341b-ec9b-41e5-a3bf-28e0387a406a","cell_type":"markdown","source":"# Week 5 - Transfer Learning\n**Introduction to Applied AI | Project 2: Deep Learning Applications | Individual**\nName: Makhdoom Bilawal\nDataset: Intel Image Classification (puneet6060) | Platform: Kaggle, GPU T4, Internet On\n\n> Setup: Settings -> Accelerator = GPU T4, Internet = On. ","metadata":{}},{"id":"73b955a3-fd15-454f-a70e-9f59252109ff","cell_type":"markdown","source":"## Part 1: The Data, and an Image as Numbers","metadata":{}},{"id":"98de2fc0-53e0-4155-8c19-3c781fe9c0c7","cell_type":"code","source":"import os\nimport time\nimport copy\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom PIL import Image\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import DataLoader, Subset\nfrom torchvision import datasets, transforms, models\nfrom sklearn.metrics import (classification_report, confusion_matrix,\n                             ConfusionMatrixDisplay)\n\ntorch.manual_seed(42)\nnp.random.seed(42)\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint('Device:', device)   # must say cuda; if not, turn on the GPU\n\nROOT = '/kaggle/input/datasets/bilawalmakhdoom/image-classfication'\nTRAIN_DIR = f'{ROOT}/seg_train/seg_train'\nTEST_DIR = f'{ROOT}/seg_test/seg_test'\nclasses = sorted(os.listdir(TRAIN_DIR))\nfor c in classes:\n    n_tr = len(os.listdir(os.path.join(TRAIN_DIR, c)))\n    n_te = len(os.listdir(os.path.join(TEST_DIR, c)))\n    print(f'{c:10s} train {n_tr:5d}   test {n_te:4d}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-18T21:18:20.5